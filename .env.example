# Copia este archivo como .env.local y completa los valores. .env.local NO se sube a git.
# Guía paso a paso: docs/BASE_DE_DATOS.md (Neon) y docs/GOOGLE_MAPS.md (clave del mapa).

# PostgreSQL en Neon (Neon Console > tu rama > Connect).
# DATABASE_URL usa el pooler (la aplicación) y DATABASE_URL_UNPOOLED es la conexión directa
# (migraciones). Si DATABASE_URL queda vacía, la API usa PostgreSQL en memoria y los datos se
# pierden al cerrar.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clave de la API de Google Maps (Maps JavaScript API). Sin clave el mapa funciona, pero se ve
# oscurecido y con la marca "For development purposes only".
VITE_GOOGLE_MAPS_API_KEY=

# Opcionales (estos son los valores por defecto)
# PUERTO=3000
# JWT_SECRETO=secreto-solo-para-desarrollo
# JWT_EXPIRA_EN=8h
