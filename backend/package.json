{
  "name": "lotes-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST: proyectos, lotes, clientes, reservas, ventas, planes de pago y pagos",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/servidor.ts",
    "start": "tsx src/servidor.ts",
    "db:reset": "tsx scripts/reiniciar-datos.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integracion": "vitest run tests",
    "test:cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
